    "findings": [
      {
        "title": "Room corridors use staged connection attempts before extra routes",
        "finding": "makecorridors attempts adjacent rooms, with a random early break, then rooms two apart with unequal smeq labels, then a bounded cross-room label pass. With more than two rooms it attempts rn2(nroom)+4 extra connections using nxcor=true. This is evidence of staged connectivity construction, not proof that all seeds produce a connected traversable level.",
        "path": "src/mklev.c",
        "lines": [
          319,
          347
        ]
      },
      {
        "title": "A failed corridor can leave geometry behind",
        "finding": "join can create its origin door before calling dig_corridor. The digger changes tiles in place and can later return FALSE on its iteration guard, optional-route random termination, boundary or terrain mismatch. Neither inspected function rolls these writes back. The target door and smeq update occur only after successful digging. Partial corridor stubs are therefore possible in this control flow; their observed frequency remains unknown.",
        "path": "src/mklev.c",
        "lines": [
          294,
          315
        ],
        "additionalEvidence": {
          "path": "src/sp_lev.c",
          "lines": [
            2246,
            2269
          ]
        }
      },
      {
        "title": "Corridor routing is a bounded local walker with secret and obstructed variants",
        "finding": "dig_corridor chooses axis movement toward the destination, perturbs relative axis distances, tries permissible turns, continues straight where permitted, and changes direction around incompatible terrain. It accepts background terrain, intended floor or secret corridor. Ordinary CORR carving can instead create SCORR; optional nxcor routes can terminate randomly and place boulders. No shortest-path or global reachability guarantee was established.",
        "path": "src/sp_lev.c",
        "lines": [
          2215,
          2321
        ]
      },
      {
        "title": "Door placement rules differ between required and extra corridors",
        "finding": "okdoor requires horizontal or vertical wall, spare door capacity and no cardinally adjacent ordinary or secret door. finddpos first tries a random candidate, scans legal wall positions, then reuses an existing door and finally falls back to a corner coordinate. join bypasses okdoor for nxcor=false at both endpoints; nxcor=true requires it. dodoor retains the capacity check. Thus okdoor is not an unconditional invariant for every corridor endpoint.",
        "path": "src/mklev.c",
        "lines": [
          1237,
          1256
        ],
        "additionalEvidence": [
          {
            "path": "src/mklev.c",
            "lines": [
              69,
              95
            ]
          },
          {
            "path": "src/mklev.c",
            "lines": [
              294,
              310
            ]
          },
          {
            "path": "src/mklev.c",
            "lines": [
              1207,
              1232
            ]
          }
        ]
      }
    ],
    "coverage": {
      "corridorControlFlow": "partial",
      "runtime": "unexamined",
      "globalConnectivityGuarantee": "unexamined",
      "smeqInitializationAndPropagation": "partial: creation and join updates traced, repository-wide writers unexamined",
      "doorAndBoulderSemantics": "partial: doorway constraints and initial door states traced; boulder movement unexamined"
    },
    "next": "Publish the four bounded corridor findings and supporting label/door traces after current catalog reconciliation, full build and deployed API/MCP plus desktop/mobile checks. Do not claim universal connectivity or traversability.",
    "labelTrace": {
