      "source": "/tile-generator",
      "destination": "/board.html"
    },
    {
      "source": "/tile-generator/:type",
      "destination": "/board.html"
    },
    {
      "source": "/board",
      "destination": "/board.html"
    },
    {
      "source": "/scene-generator",
      "has": [
        {
          "type": "query",
          "key": "scene",
          "value": "woodland"
        }
      ],
      "destination": "/working-woodland.html"
    },
    {
      "source": "/scene-generator/woodland",
      "destination": "/working-woodland.html"
    },
    {
      "source": "/scene-generator",
      "has": [
        {
          "type": "query",
          "key": "scene",
          "value": "garden"
        }
      ],
      "destination": "/garden-farm.html"
    },
    {
      "source": "/scene-generator/garden",
      "destination": "/garden-farm.html"
    },
    {
      "source": "/scene-generator",
      "has": [
        {
          "type": "query",
          "key": "scene",
          "value": "market"
        }
      ],
      "destination": "/market.html"
    },
    {
      "source": "/scene-generator/market",
      "destination": "/market.html"
    },
    {
      "source": "/mood-board",
      "destination": "/mood-board.html"
    },
    {
      "source": "/3d",
      "destination": "/3d.html"
    },
    {
      "source": "/3d/barn-builder",
      "destination": "/barn-builder.html"
    },
    {
      "source": "/procedural",
      "destination": "/board.html"
    },
    {
      "source": "/simulation",
      "destination": "/simulation.html"
    },
    {
      "source": "/3d/asset-studies",
      "destination": "/asset-studies.html"
    },
    {
      "source": "/3d/simulation-assets",
      "destination": "/simulation-assets.html"
    },
    {
      "source": "/themes",
      "destination": "/themes.html"
    },
    {
      "source": "/scene-generator",
      "destination": "/board.html"
    },
    {
      "source": "/market",
      "destination": "/market.html"
    },
    {
      "source": "/scene-generator/simulation",
      "destination": "/scene-generator.html"
    },
    {
      "source": "/sets",
      "destination": "/sets.html"
    },
    {
      "source": "/sets/:path*",
      "destination": "/sets.html"
    },
    {
      "source": "/scene-generator/prefabs",
      "destination": "/sets.html"
    },
    {
      "source": "/scene-generator/prefabs/:path*",
      "destination": "/sets.html"
    },
    {
      "source": "/units",
      "destination": "/units.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "public-build",
  "headers": [
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ],
      "source": "/view-context.js"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ],
      "source": "/view-build.json"
    }
  ],
  "redirects": [
    {
      "source": "/simulations",
      "destination": "/simulations/",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/sandbox",
      "permanent": false
    },
    {
      "source": "/town-life",
      "destination": "/tile-generator/town",
      "permanent": false
    },
    {
