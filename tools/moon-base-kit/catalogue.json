{
 "study": "AW-STUDY-0031",
 "groups": {
  "exterior": {
   "title": "Exterior structures and infrastructure",
   "note": "Dome, tower, habitat/hangar, airlock and supply crate were handed over by the Moon Heroes thread (2026-10-23): engineered recipes here, Meshy stays for heroes."
  },
  "interior": {
   "title": "Interior architecture kit (modular, 2 m grid)",
   "note": "Every piece snaps to a 2 m grid with doorway sockets."
  },
  "furniture": {
   "title": "Interior furniture and fixtures",
   "note": "Sized for Abbie (4.5 heads) and Daddy (7.5 heads); seats at kid and adult height."
  },
  "terrain": {
   "title": "Terrain kit",
   "note": "Matches the regolith grammar in simulations/moon/moon-regolith.mjs."
  },
  "props": {
   "title": "Props: tools, cargo and science",
   "note": "Every prop carries mass and a grab point for low-g throwing."
  },
  "pickups": {
   "title": "Pickups and collectibles",
   "note": "Gold only for memory coins; cyan crystal pickup is the Bruiser thread's."
  },
  "signals": {
   "title": "Diegetic signals (no HUD)",
   "note": "Ask \"how would Abbie know?\" first: a dial, a lamp, a bell before any overlay."
  },
  "play": {
   "title": "Low-gravity toys and interactables",
   "note": "Every one exaggerates low gravity: arcs, slow falls, dust that hangs."
  },
  "support": {
   "title": "Support machines (not heroes)",
   "note": "Machines read as machines: charcoal with role lights, never cyan."
  }
 },
