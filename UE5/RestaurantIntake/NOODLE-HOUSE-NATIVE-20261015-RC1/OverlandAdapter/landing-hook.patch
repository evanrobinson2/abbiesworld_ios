+// Review-only adapter; never infer placement from coffee POI coordinates or mesh bounds.
+bool AAmberHUD::AddRestaurantPlacement(const FRTEncounterPlacement& P)
+{
+ if(!Identity||!Identity->UniverseJoined||P.Universe!=Identity->UniverseId||P.World!=Identity->UniverseMap)return false;
+ RestaurantGate.WalkableCells.Reset();for(const auto& Key:TileKeys){FString Q,R;int32 X,Y;if(Key.Split(TEXT(","),&Q,&R)&&LexTryParseString(X,*Q)&&LexTryParseString(Y,*R))RestaurantGate.WalkableCells.Add(FIntPoint(X,Y));}
+ const auto Entry=P.Hex+P.Rotate(P.EntryOffset);if(!RouteKeys.Contains(FString::Printf(TEXT("%d,%d"),Entry.X,Entry.Y)))return false;
+ return RestaurantGate.Place(P);
+}
+void AAmberHUD::NotifyRestaurantLanding()
+{
+ if(!Identity||!Identity->UniverseJoined||!RouteKeys.IsValidIndex(Step)||!GetWorld()->GetMapName().EndsWith(Identity->UniverseMap))return;
+ FString Q,R;int32 X,Y;if(!RouteKeys[Step].Split(TEXT(","),&Q,&R)||!LexTryParseString(X,*Q)||!LexTryParseString(Y,*R))return;
+ FRTEncounterRequest Request;if(RestaurantGate.Land(Identity->UniverseId,Identity->UniverseMap,Identity->ActiveProfileId,FString::Printf(TEXT("turn:%d"),Turn),FIntPoint(X,Y),Request)){
+  // Consumer shows entry dialogue, then asks authorized session broker. No direct travel here.
