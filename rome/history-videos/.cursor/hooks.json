{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/mind-session-start.py"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/mind-append.py"
      }
    ],
    "afterAgentResponse": [
      {
        "command": ".cursor/hooks/mind-append.py"
      }
    ],
    "sessionEnd": [
      {
        "command": ".cursor/hooks/mind-append.py"
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/mind-append.py"
      }
    ]
  }
}
